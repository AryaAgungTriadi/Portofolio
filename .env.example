# Server-only. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Random secret of at least 32 characters; used to hash submission IP addresses.
SUBMISSION_HASH_SECRET=
RESEND_API_KEY=
# For initial testing: onboarding@resend.dev. Production: verified sender domain.
CONTACT_FROM_EMAIL=Portfolio Arya <onboarding@resend.dev>
# With resend.dev, this must match the email used to sign up for Resend.
CONTACT_TO_EMAIL=aryaagungtriadi22@gmail.com

# OAuth uses the publishable key, never the secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Optional Supabase Authentication user UUID for Arya (never a display name).
GUESTBOOK_OWNER_ID=
